# Copy to .env and fill in. .env is gitignored; chmod 600 it on the host.

# --- broker ---
# mosquitto publishes 1883 on osmo's host, so from inside this compose stack
# point at osmo itself rather than assuming a shared network with that
# container.
MQTT_HOST=10.0.0.5
MQTT_PORT=1883
MQTT_TOPIC=avatar/say
# Must NOT collide with the firmware's own client id ("avatar-demo") - a
# duplicate id kicks the device off the broker.
MQTT_CLIENT_ID=mqttchan-api
# PubSubClient's buffer in firmware/include/mqtt_link.h. The device drops
# anything larger silently - no error, no callback. Raise here only after
# raising setBufferSize() there.
MQTT_MAX_PAYLOAD_BYTES=512

# --- api ---
PORT=8420

# --- pacing ---
# Used to estimate how long the device is busy with a message. Should match the
# device's own hold time (control page -> Messaging -> hold seconds).
DEVICE_HOLD_SECONDS=30
DEVICE_CHAR_MS=45

# Per-source token bucket. The pacing above is the real limiter; this just stops
# one noisy feed monopolising the device.
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_MINUTE=10

# Messages not shown within this long are dropped rather than shown stale.
DEFAULT_TTL_SECONDS=900

# --- feeds/flights ---
# The airport to watch, as an aerodrome reference point. Defaults below are
# Queenstown (ZQN/NZQN); compose sets them per-service, so these are only for
# running the feed by hand. AIRPORT_CODE is just the text shown on the device.
AIRPORT_CODE=ZQN
AIRPORT_LAT=-45.0211
AIRPORT_LON=168.7392
# How far out to watch. Not about seeing distant traffic - it is the runway an
# arrival needs to be seen airborne on before it lands, so touchdown reads as a
# change rather than a first sighting. 30nm is roughly ten minutes of descent.
AIRPORT_RADIUS_NM=30
# How close "on the ground *here*" is. Must not reach a neighbouring strip:
# Cromwell sits ~25nm away, inside the watch circle.
AIRPORT_GROUND_RADIUS_NM=1.5
# Suppress a repeat of the same aircraft's same movement for this long. A
# circuit or a go-around produces real ground/air edges nobody wants twice.
FLIGHTS_COOLDOWN_MS=600000

# --- feeds/ha-temperature ---
# Same HA_URL/HA_TOKEN convention as the old avatar-brain producer this
# replaces. Long-lived access token: HA profile -> Security -> Long-Lived
# Access Tokens. The token that was left in avatar-brain's own .env on osmo
# returns 401 - generate a fresh one, do not reuse it.
HA_URL=https://ha.kev.nz
HA_TOKEN=
# Which HA integration counts as "Zigbee" - defaults to native ZHA. NOT yet
# confirmed against the live instance; if it actually runs Zigbee2MQTT or
# deCONZ instead, this must change or the feed silently sees zero sensors.
# Check with: node feeds/ha-temperature/dist/index.js --once --dry-run
HA_ZIGBEE_INTEGRATION=zha
# How much a room's reading has to move before it's worth reporting again.
TEMPERATURE_CHANGE_THRESHOLD_C=0.5
TEMPERATURE_TTL_SECONDS=900

# --- feeds/sky ---
# Sun/moon/planet digest, aurora Kp alert, MetService warnings. Location is
# three environment variables, same convention as feeds/flights' airport;
# compose sets them for Queenstown, these are only for running by hand.
LOCATION_NAME=Queenstown, Otago, NZ
LOCATION_LAT=-45.0311
LOCATION_LON=168.6626
LOCATION_ELEVATION_M=310
LOCATION_TIMEZONE=Pacific/Auckland
# Matched case-insensitively against each MetService CAP alert's areaDesc.
# Default covers Queenstown Lakes district and its usual named sub-areas.
SKY_REGION_KEYWORDS=Otago,Queenstown,Southern Lakes,Wakatipu,Wanaka,Crown Range,Cardrona,Coronet Peak,Remarkables,Fiordland
# Planetary Kp index thresholds for an aurora alert (on) and for clearing it
# (off, below on - hysteresis so a bouncing reading doesn't alert twice).
SKY_AURORA_KP_ON=5
SKY_AURORA_KP_OFF=4
# MetService's Point Forecast API key (console.metoceanapi.com), x-api-key
# header - for today's temperature/rain/wind outlook in the daily digest.
# Confirmed live 2026-09-19 against Queenstown's coordinates. Every other
# part of this feed (sun/moon/planets, aurora, warnings) needs no key; leave
# this blank to run without the weather clause rather than not run at all.
METSERVICE_API_KEY=
