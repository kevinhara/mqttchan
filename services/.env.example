# Copy to .env and fill in. .env is gitignored; chmod 600 it on the host.

# --- broker ---
# mosquitto publishes 1883 on osmo's host, so from inside this compose stack
# point at osmo itself rather than assuming a shared network with that
# container.
MQTT_HOST=10.0.0.5
MQTT_PORT=1883
MQTT_TOPIC=avatar/say
# Must NOT collide with the firmware's own client id ("avatar-demo") - a
# duplicate id kicks the device off the broker.
MQTT_CLIENT_ID=mqttchan-api
# PubSubClient's buffer in firmware/include/mqtt_link.h. The device drops
# anything larger silently - no error, no callback. Raise here only after
# raising setBufferSize() there.
MQTT_MAX_PAYLOAD_BYTES=512

# --- api ---
PORT=8420

# --- pacing ---
# Used to estimate how long the device is busy with a message. Should match the
# device's own hold time (control page -> Messaging -> hold seconds).
DEVICE_HOLD_SECONDS=30
DEVICE_CHAR_MS=45

# Per-source token bucket. The pacing above is the real limiter; this just stops
# one noisy feed monopolising the device.
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_MINUTE=10

# Messages not shown within this long are dropped rather than shown stale.
DEFAULT_TTL_SECONDS=900

# --- feeds/flights ---
# The airport to watch, as an aerodrome reference point. Defaults below are
# Queenstown (ZQN/NZQN); compose sets them per-service, so these are only for
# running the feed by hand. AIRPORT_CODE is just the text shown on the device.
AIRPORT_CODE=ZQN
AIRPORT_LAT=-45.0211
AIRPORT_LON=168.7392
# How far out to watch. Not about seeing distant traffic - it is the runway an
# arrival needs to be seen airborne on before it lands, so touchdown reads as a
# change rather than a first sighting. 30nm is roughly ten minutes of descent.
AIRPORT_RADIUS_NM=30
# How close "on the ground *here*" is. Must not reach a neighbouring strip:
# Cromwell sits ~25nm away, inside the watch circle.
AIRPORT_GROUND_RADIUS_NM=1.5
# Suppress a repeat of the same aircraft's same movement for this long. A
# circuit or a go-around produces real ground/air edges nobody wants twice.
FLIGHTS_COOLDOWN_MS=600000
