.DS_Store

# --- firmware ---
# Build output and real credentials (copy firmware/include/secrets.h.example).
firmware/.pio/
firmware/include/secrets.h

# Generated by the IDF-style build custom_sdkconfig triggers (see
# firmware/platformio.ini) - regenerated every build, thousands of lines, not
# meant to be hand-edited or diffed.
firmware/.dummy/
firmware/managed_components/
firmware/sdkconfig.defaults
firmware/sdkconfig.esp32dev

# --- services ---
node_modules/
dist/
services/.env
# tsc --build incremental state. Committing these is actively harmful: a stale
# one convinces tsc everything is already compiled, so it emits nothing - which
# is how the Docker image first came out with no JavaScript in it at all.
*.tsbuildinfo
